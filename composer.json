{
  "name": "hearth/license-client",
  "description": "Laravel helper package that verifies a license key against master-data.ro and stores the result locally.",
  "type": "library",
  "license": "MIT",
  "version": "0.1.3",
  "autoload": {
    "psr-4": {
      "Hearth\\LicenseClient\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Hearth\\LicenseClient\\LicenseServiceProvider"
      ]
    }
  },
  "require": {
    "php": "^8.2",
    "illuminate/console": "^11.0|^12.0|^13.0",
    "illuminate/contracts": "^11.0|^12.0|^13.0",
    "illuminate/http": "^11.0|^12.0|^13.0",
    "illuminate/routing": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0"
  }
}
